# Copy to .env.local (git-ignored) for local overrides, or set these as Vercel project
# environment variables for Preview and Production. Never commit real values.

# Production only: Postgres connection string (e.g. Neon). Local dev uses PGlite in .data/pglite.
DATABASE_URL=

# Exact origin the app is served from, e.g. https://my-first-aiapp.vercel.app
APP_ORIGIN=http://127.0.0.1:5173

# Access-token signing secrets, newest first, comma-separated, each at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETS=

# Secret for hashing IPs and emails in rate-limit keys (at least 32 random characters).
IP_HASH_SECRET=

# "false" only for local http development.
COOKIE_SECURE=true

# Email for password resets. Production uses the first one configured:
# 1. Gmail (or any SMTP server): SMTP_USER is the full Gmail address, SMTP_PASS a Google App Password
#    (Google Account → Security → 2-Step Verification → App passwords). Emails come from SMTP_USER.
#    SMTP_HOST/SMTP_PORT default to smtp.gmail.com:465.
# 2. Resend: RESEND_API_KEY (needs a verified sending domain to reach anyone but yourself).
# With neither, reset emails are not sent in production (a warning is logged).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=
# Optional sender, e.g. "Habits <you@gmail.com>". Defaults to "Habits <SMTP_USER>" with SMTP.
MAIL_FROM=
