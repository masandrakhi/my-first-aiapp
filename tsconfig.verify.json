{
  // Used only by `npm run verify`: emits the API as separate JavaScript files, without bundling, the way
  // Vercel's Node builder does, so scripts/smoke-api.mjs can load it like the live function.
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "incremental": true,
    "tsBuildInfoFile": "./.verify/tsconfig.verify.tsbuildinfo",
    "outDir": "./.verify/build",
    "rootDir": "."
  },
  "include": ["api", "server"],
  "exclude": ["server/test"]
}
